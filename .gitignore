# Virtual environments (all third-party packages live here, not in git)
venv/
.venv/
env/
ENV/

# Python
__pycache__/
*.pyc
*.pyo
*.so
*.egg-info/
*.dist-info/

# Runtime cache / generated data
filing_cache.json

# The scraped database IS committed so the deployed app has data to read.
# Only the transient WAL/shared-memory sidecars are ignored.
insider.db-wal
insider.db-shm

# Cached SEC reference data (re-downloaded on demand)
.cache/

# Secrets (API keys) — never commit
.streamlit/secrets.toml

# OS / editor
.DS_Store
.vscode/
.idea/
